generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    Int              @id @default(autoincrement())
  name                  String
  cnpj                  String?
  isActive              Boolean          @default(true)
  type                  String           @default("MATRIZ")
  groupId               String?
  managerId             Int?
  dominioRubric         String?
  dominioCode           String?
  planId                Int?
  status                String           @default("active")
  subscriptionExpiresAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  userId                Int?
  group                 Group?           @relation(fields: [groupId], references: [id])
  manager               User?            @relation("CompanyManager", fields: [managerId], references: [id])
  plan                  Plan?            @relation(fields: [planId], references: [id])
  user                  User?            @relation(fields: [userId], references: [id])
  employees             Employee[]
  meals                 Meal[]
  users                 User[]           @relation("LegacyCompanyUsers")
  members               UserMembership[]
  roles                 Role[]           @relation("CompanyToRole")

  @@index([groupId], map: "Company_groupId_fkey")
  @@index([managerId], map: "Company_managerId_fkey")
  @@index([planId], map: "Company_planId_fkey")
  @@index([userId], map: "Company_userId_fkey")
}

model Plan {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  maxUsers  Int
  features  String
  price     Decimal   @default(0.000000000000000000000000000000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  roleId    Int
  companyId Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   Int?
  action    String
  entity    String
  entityId  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Group {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
}

model UserMembership {
  id        String   @id @default(uuid())
  userId    Int
  companyId Int
  roleId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId], map: "UserMembership_companyId_fkey")
  @@index([roleId], map: "UserMembership_roleId_fkey")
}

model Feature {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  featureId   Int
  feature     Feature @relation(fields: [featureId], references: [id])
  roles       Role[]  @relation("PermissionToRole")

  @@index([featureId], map: "Permission_featureId_fkey")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  members     UserMembership[]
  companies   Company[]        @relation("CompanyToRole")
  permissions Permission[]     @relation("PermissionToRole")
}

model User {
  id                 Int              @id @default(autoincrement())
  email              String           @unique
  password           String
  name               String
  phone              String?
  jobTitle           String?
  bio                String?
  address            String?
  preferences        String?
  isActive           Boolean          @default(true)
  companyId          Int?
  roleId             Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  managedCompanies   Company[]        @relation("CompanyManager")
  companies          Company[]
  sentMessages       Message[]
  notifications      Notification[]
  ownedTasks         Task[]           @relation("TaskOwner")
  comments           TaskComment[]
  company            Company?         @relation("LegacyCompanyUsers", fields: [companyId], references: [id])
  role               Role?            @relation(fields: [roleId], references: [id])
  memberships        UserMembership[]
  collaboratingTasks Task[]           @relation("TaskCollaborators")
  conversations      Conversation[]   @relation("UserConversations")

  @@index([companyId], map: "User_companyId_fkey")
  @@index([roleId], map: "User_roleId_fkey")
}

model Employee {
  id           Int       @id @default(autoincrement())
  matricula    String    @unique
  firstName    String
  lastName     String?
  cpf          String?   @unique
  funcao       String?
  setor        String?
  dataAdmissao DateTime
  dataDemissao DateTime?
  companyId    Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id])
  meals        Meal[]

  @@index([companyId], map: "Employee_companyId_fkey")
}

model Task {
  id            String        @id @default(uuid())
  title         String
  description   String?
  status        String        @default("todo")
  priority      String        @default("medium")
  isPublic      Boolean       @default(false)
  ownerUserId   Int
  createdAt     DateTime      @default(now())
  completedAt   DateTime?
  updatedAt     DateTime      @updatedAt
  owner         User          @relation("TaskOwner", fields: [ownerUserId], references: [id])
  comments      TaskComment[]
  collaborators User[]        @relation("TaskCollaborators")

  @@index([ownerUserId], map: "Task_ownerUserId_fkey")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  content   String
  taskId    String
  authorId  Int
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([authorId], map: "TaskComment_authorId_fkey")
  @@index([taskId], map: "TaskComment_taskId_fkey")
}

model Notification {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String
  entityId    String?
  userId      Int
  actorName   String?
  read        Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Notification_userId_fkey")
}

model Conversation {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  messages      Message[]
  participants  User[]    @relation("UserConversations")
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       Int
  conversationId String
  createdAt      DateTime     @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  status         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId], map: "Message_conversationId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

model Meal {
  id                     Int       @id @default(autoincrement())
  date                   DateTime
  price                  Decimal
  periodStart            DateTime?
  periodEnd              DateTime?
  employeeId             Int?
  matriculaSnapshot      String    @default("")
  employeeNameSnapshot   String?
  employeeSectorSnapshot String?
  status                 String    @default("LINKED")
  ignoredInExport        Boolean   @default(false)
  companyId              Int
  createdAt              DateTime  @default(now())
  company                Company   @relation(fields: [companyId], references: [id])
  employee               Employee? @relation(fields: [employeeId], references: [id])

  @@index([companyId], map: "Meal_companyId_fkey")
  @@index([employeeId], map: "Meal_employeeId_fkey")
}
